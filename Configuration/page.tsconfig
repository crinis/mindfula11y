mod {
    mindfula11y_accessibility {
        missingAltText {
            enable = 1
            # Exclude file fields from the missing-alt check, per table, e.g. for fields
            # that are decorative by design:
            # ignoreColumns {
            #     tx_myext_domain_model_hero = background_image
            # }
            # 0 = let editors filter out references covered by metadata alt text (matching
            # TYPO3's rendered output); 1 = ignore metadata and require reference-level alt.
            ignoreFileMetadata = 0
        }
        headingStructure {
            enable = 1
        }
        landmarkStructure {
            enable = 1
        }
        scan {
            enable = 0
            autoCreate = 1
            # Deprecated: basicAuthUsername / basicAuthPassword. Configure
            # mindfula11y.scan.basicAuth.username/password in the site configuration
            # instead (config/sites/<identifier>/config.yaml; the password may be an
            # %env()% placeholder). The TSconfig keys remain as fallback but are
            # ignored as soon as either key is set in the site configuration.
            aiAudit {
                # Offer the "Include AI review" toggle in the scan module. Requires the
                # scanner API to run with its optional agent feature enabled (AGENT_ENABLED).
                enable = 0
                # Pre-select the toggle for new scans. Editors can still switch it off per scan.
                default = 0
                # Scan modes the AI review may run for, as MindfulAPI names them: single_url
                # (one page), url_list (a page with child levels that resolves to several
                # pages), crawl (full-site crawl). A page without subpages scanned with child
                # levels is sent as single_url. Every scanned page is reviewed, up to
                # MindfulAPI's per-scan unit cap, so widen this deliberately. Where MindfulAPI
                # restricts the modes too (AGENT_ALLOWED_SCAN_MODES), it must list them as well.
                scanModes = single_url
                # Optional subset. Leave unset to run every skill enabled on MindfulAPI.
                # An empty value switches the AI review off (the toggle is not offered).
                # skills = image_alt_text,page_title
            }
        }
    }

    web_layout {
        mindfula11y {
            hideInfo = 0
        }
    }
}

# Hide structural landmarks from content editors by default.
# These should typically be controlled at template level.
# Note: TCEFORM.removeItems is a FormEngine (UI) default only — DataHandler
# does not validate select values against the reduced item list, so this is
# an editorial guardrail, not an enforced restriction.
TCEFORM.tt_content.tx_mindfula11y_landmark {
    removeItems = main,banner,contentinfo,form
}
